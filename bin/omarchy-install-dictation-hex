#!/bin/bash

# omarchy:summary=Install and configure Hex dictation
# omarchy:requires-sudo=true

set -e

# Omarchy-Nix: omarchy.hex.enable installs the package.
if omarchy-cmd-missing hex; then
  echo "Hex is not installed. Set omarchy.hex.enable = true and rebuild." >&2
  exit 1
fi
# Download the speech model here, with progress, instead of silently on first launch.
hex model install
# Omarchy-Nix: omarchy.hex.enable enables hex.service. `systemctl --user enable`
# would link the unit's store path into ~/.config/systemd/user.
# Launching through the CLI saves this session's display environment for the unit before starting it.
hex start
omarchy-dictation-use hex
omarchy-restart-hyprctl
omarchy-notification-send -g  "$(omarchy-i18n dictation.hexReady)" "$(omarchy-i18n dictation.hint)" -t 10000
